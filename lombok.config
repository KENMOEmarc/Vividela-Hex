config.stopBubbling = true

# FIX: @RequiredArgsConstructor (Lombok) does NOT copy, by default, ANY
# annotation placed on a field to the corresponding parameter of the
# constructor it generates. @Lazy placed on the OrderServiceImpl.articleService
# field (used to break the dependency cycle ArticleServiceImpl →
# OrderServiceImpl → ArticleService) was therefore invisible to Spring at
# injection time, and the cycle persisted despite the annotation — causing the
# startup failure "The dependencies of some of the beans ... form a cycle".
#
# This line explicitly tells Lombok to copy @Lazy onto the generated parameter,
# which is the documented way to combine @RequiredArgsConstructor with @Lazy
# to resolve a Spring cycle.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy