<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================
    SPRING BOOT PARENT
    Provides version management for all Spring Boot dependencies
    (auto-configuration, starters, Maven plugins).
    ============================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <!-- Project identity -->
    <groupId>ken.vivid</groupId>
    <artifactId>vividela-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>vividela-backend</name>
    <description>
        Hexagonal Architecture | JWT | MySQL
    </description>

    <!-- Target Java version -->
    <properties>
        <java.version>21</java.version>
        <!-- JWT library version -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Force connector-j 9.x for MySQL 8.4 (removes mysql_native_password) -->
        <mysql-connector-j.version>9.1.0</mysql-connector-j.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Spring AI — used for AI analysis (Gemini) of customer reviews,
             see GeminiReviewAnalysisService. -->
        <spring-ai.version>1.1.6</spring-ai.version>
    </properties>

    <!-- =====================================================
         SPRING AI BOM — automatically aligns the versions of all
         Spring AI starters (never set an individual <version> on
         an org.springframework.ai artifact: it breaks BOM alignment).
         ===================================================== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- =====================================================
         Fallback repository for Spring AI artifacts if a milestone/RC
         version were to be used (GA versions are on Maven Central).
         No impact if everything is already resolved via Central.
         ===================================================== -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>

        <!-- =====================================================
             WEB — Provides Spring MVC, the embedded Tomcat server,
             Jackson (JSON), and everything needed for REST.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- =====================================================
             SECURITY — Authentication filter, permission management,
             password encoding (BCrypt).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- =====================================================
             JPA / HIBERNATE — ORM to map Java entities to PostgreSQL
             tables, transaction management.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- =====================================================
             VALIDATION — @NotBlank, @Email, @Size… annotations to
             validate DTOs in controller inputs.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- =====================================================
             MYSQL — JDBC driver for connecting to MySQL 8.x database.
             ===================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- =====================================================
             LOMBOK — Automatic generation of getters, setters,
             constructors, builders via annotations (@Data, @Builder…).
             Avoids boilerplate code.
             ===================================================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- =====================================================
             JWT (JSON Web Token) — JJWT library to generate, sign
             and validate JWT tokens (HS256).
             ===================================================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- =====================================================
             OPENPDF — PDF document generation (order tickets).
             100% Java library, no native dependency.
             ===================================================== -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.39</version>
        </dependency>

        <!-- =====================================================
             MAIL — Spring Boot starter providing JavaMailSender
             for sending emails via SMTP (Gmail, SendGrid, etc.).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- =====================================================
             DOTENV — Automatically loads the .env file at the project
             root into the Spring Environment at startup. Without this
             dependency, the ${VARS} in application.yml are never
             resolved from .env (you would have to export them manually
             in the shell, or rely solely on docker-compose).
             ===================================================== -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- =====================================================
             SPRING AI — GOOGLE GENAI (GEMINI) — used to analyze (via
             the Gemini 2.5 API) the sentiment of customer reviews before
             notifying the pressing manager. See GeminiReviewAnalysisService
             and the spring.ai.google.genai.* properties (application.yml).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <!-- Use release to ensure correct cross-compilation and avoid internal TypeTag issues -->
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Fork the compiler to isolate from Maven's embedded javac implementations when necessary -->
                    <fork>true</fork>
                </configuration>
            </plugin>
            <!-- Maven plugin to compile and package the application -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final JAR (annotations compiled) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>